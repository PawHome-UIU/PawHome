  <diagram name="0  How to read this" id="0  How to read this">
    <mxGraphModel dx="2200" dy="1120" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="PawHome &amp;#8212; entity relationship diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1400" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="CSE 3522 Database Management Systems Laboratory &amp;#183; MySQL 8.4, InnoDB, utf8mb4.&lt;br&gt;27 tables, 53 foreign keys. Drawn in black and white only: nothing here means anything by its colour, so the diagram survives a photocopier and a projector." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="62" y="95" width="1400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="smp" value="a_table" style="swimlane;html=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeLast=0;collapsible=0;marginBottom=0;swimlaneLine=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=16;fontStyle=1;fontFamily=Helvetica;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="330" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="smpr0" value='&lt;table cellpadding="0" cellspacing="0" border="0" style="width:308px;table-layout:fixed;font-size:13px;font-family:Helvetica,Arial,sans-serif"&gt;&lt;tr&gt;&lt;td style="width:32px"&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style="width:158px"&gt;&lt;u&gt;id&lt;/u&gt;&lt;/td&gt;&lt;td style="width:118px;text-align:right"&gt;BIGINT NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=11;overflow=hidden;points=[[0,0.5,0,0,0],[1,0.5,0,0,0]];portConstraint=eastwest;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="smp">
          <mxGeometry x="0" y="40" width="330" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="smpr1" value='&lt;table cellpadding="0" cellspacing="0" border="0" style="width:308px;table-layout:fixed;font-size:13px;font-family:Helvetica,Arial,sans-serif"&gt;&lt;tr&gt;&lt;td style="width:32px"&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td style="width:158px"&gt;shelter_id&lt;/td&gt;&lt;td style="width:118px;text-align:right"&gt;BIGINT NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=11;overflow=hidden;points=[[0,0.5,0,0,0],[1,0.5,0,0,0]];portConstraint=eastwest;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="smp">
          <mxGeometry x="0" y="68" width="330" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="smpr2" value='&lt;table cellpadding="0" cellspacing="0" border="0" style="width:308px;table-layout:fixed;font-size:13px;font-family:Helvetica,Arial,sans-serif"&gt;&lt;tr&gt;&lt;td style="width:32px"&gt;&lt;b&gt;U&lt;/b&gt;&lt;/td&gt;&lt;td style="width:158px"&gt;email&lt;/td&gt;&lt;td style="width:118px;text-align:right"&gt;VARCHAR(160) NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=11;overflow=hidden;points=[[0,0.5,0,0,0],[1,0.5,0,0,0]];portConstraint=eastwest;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="smp">
          <mxGeometry x="0" y="96" width="330" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="smpr3" value='&lt;table cellpadding="0" cellspacing="0" border="0" style="width:308px;table-layout:fixed;font-size:13px;font-family:Helvetica,Arial,sans-serif"&gt;&lt;tr&gt;&lt;td style="width:32px"&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style="width:158px"&gt;&lt;i&gt;job_title&lt;/i&gt;&lt;/td&gt;&lt;td style="width:118px;text-align:right"&gt;VARCHAR(80)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=11;overflow=hidden;points=[[0,0.5,0,0,0],[1,0.5,0,0,0]];portConstraint=eastwest;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="smp">
          <mxGeometry x="0" y="124" width="330" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="smpr4" value='&lt;table cellpadding="0" cellspacing="0" border="0" style="width:308px;table-layout:fixed;font-size:13px;font-family:Helvetica,Arial,sans-serif"&gt;&lt;tr&gt;&lt;td style="width:32px"&gt;&lt;b&gt;PF&lt;/b&gt;&lt;/td&gt;&lt;td style="width:158px"&gt;&lt;u&gt;pet_id&lt;/u&gt;&lt;/td&gt;&lt;td style="width:118px;text-align:right"&gt;BIGINT NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=11;overflow=hidden;points=[[0,0.5,0,0,0],[1,0.5,0,0,0]];portConstraint=eastwest;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="smp">
          <mxGeometry x="0" y="152" width="330" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="k1" value="&lt;b&gt;Inside a table&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; &amp;#160; primary key &amp;#8212; also &lt;u&gt;underlined&lt;/u&gt;&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; &amp;#160; foreign key&lt;br&gt;&lt;b&gt;PF&lt;/b&gt; &amp;#160; both at once: part of the primary key AND a foreign key. Every one of these is a junction table resolving a many&amp;#8209;to&amp;#8209;many.&lt;br&gt;&lt;b&gt;U&lt;/b&gt; &amp;#160; &amp;#160;carries a UNIQUE constraint of its own&lt;br&gt;&lt;b&gt;NN&lt;/b&gt; &amp;#160;NOT NULL&lt;br&gt;&lt;i&gt;italic&lt;/i&gt; &amp;#160;nullable &amp;#8212; the value is allowed to be absent, and any query that reads it has to say what absent means" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=16;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="470" y="250" width="660" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="k2" value="&lt;b&gt;Between tables&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="80" y="570" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="kesolid" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToMany;startFill=0;startSize=14;endArrow=ERmandOne;endFill=0;endSize=14;jumpStyle=arc;jumpSize=10;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="620" as="sourcePoint"/>
            <mxPoint x="400" y="620" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ktsolid" value="The foreign key is &lt;b&gt;NOT NULL&lt;/b&gt;. Every child must name a parent: an adoption without an adopter is not a row this database will accept." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="470" y="582" width="660" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="klsolid" value="many" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="628" width="60" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="krsolid" value="one" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="628" width="110" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="kedash" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToMany;startFill=0;startSize=14;endArrow=ERzeroToOne;endFill=0;endSize=14;jumpStyle=arc;jumpSize=10;dashed=1;dashPattern=6 5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="730" as="sourcePoint"/>
            <mxPoint x="400" y="730" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ktdash" value="The foreign key is &lt;b&gt;nullable&lt;/b&gt;. The parent is optional: &lt;i&gt;users.shelter_id&lt;/i&gt; is NULL for every adopter, because only staff belong to a shelter." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="470" y="692" width="660" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="kldash" value="many" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="738" width="60" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="krdash" value="zero or one" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="738" width="110" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="keone" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToOne;startFill=0;startSize=14;endArrow=ERmandOne;endFill=0;endSize=14;jumpStyle=arc;jumpSize=10;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="840" as="sourcePoint"/>
            <mxPoint x="400" y="840" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ktone" value="The foreign key is &lt;b&gt;UNIQUE&lt;/b&gt;, so the relationship is one&amp;#8209;to&amp;#8209;one: &lt;i&gt;adoptions.application_id&lt;/i&gt; means one application can settle into at most one adoption." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="470" y="802" width="660" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="klone" value="one" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="848" width="60" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="krone" value="one" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=none;strokeColor=none;overflow=width;whiteSpace=wrap;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="848" width="110" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="k3" value="&lt;b&gt;The crow's foot is always on the child&lt;/b&gt; &amp;#8212; the table that holds the foreign key column. Read a line from the foot towards the bar: &lt;i&gt;many pets are housed at one shelter.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=16;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="80" y="980" width="1050" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="k4" value="&lt;b&gt;Why the lines never cross a box&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tables sit on a grid. The vertical bands between columns and the horizontal bands between rows are kept empty, and every line is routed so that it only ever travels vertically inside a vertical band and horizontally inside a horizontal band. A line therefore cannot pass over a table &amp;#8212; not by luck, by construction. This is checked automatically for all 53 relationships before the file is written.&lt;br&gt;&lt;br&gt;Where two lines have to cross each other, the crossing is drawn as a small hop &lt;b&gt;&amp;#8901;&amp;#8964;&amp;#8901;&lt;/b&gt; so it is never mistaken for a junction." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=16;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1210" y="250" width="910" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="k5s" value="another_table  (see its own page)" style="swimlane;html=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeLast=0;collapsible=0;marginBottom=0;swimlaneLine=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=16;fontStyle=1;fontFamily=Helvetica;strokeWidth=2;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="640" width="330" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="k5r" value='&lt;table cellpadding="0" cellspacing="0" border="0" style="width:308px;table-layout:fixed;font-size:13px;font-family:Helvetica,Arial,sans-serif"&gt;&lt;tr&gt;&lt;td style="width:32px"&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style="width:158px"&gt;&lt;u&gt;id&lt;/u&gt;&lt;/td&gt;&lt;td style="width:118px;text-align:right"&gt;BIGINT NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=11;overflow=hidden;points=[[0,0.5,0,0,0],[1,0.5,0,0,0]];portConstraint=eastwest;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="k5s">
          <mxGeometry x="0" y="40" width="330" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="k6" value="&lt;b&gt;A dashed box with only its key&lt;/b&gt; is a table that belongs to a different page. It is shown so the relationship has somewhere to land; its columns are on the page that owns it." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=16;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1580" y="626" width="540" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="k7" value="&lt;b&gt;The pages&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; &amp;#160;Full ERD &amp;#8212; all 27 tables and all 53 keys&lt;br&gt;&lt;b&gt;2&lt;/b&gt; &amp;#160;Identity, shelters and access&lt;br&gt;&lt;b&gt;3&lt;/b&gt; &amp;#160;Pets, traits and health&lt;br&gt;&lt;b&gt;4&lt;/b&gt; &amp;#160;The matching quiz&lt;br&gt;&lt;b&gt;5&lt;/b&gt; &amp;#160;Adoption&lt;br&gt;&lt;b&gt;6&lt;/b&gt; &amp;#160;Boarding and care&lt;br&gt;&lt;b&gt;7&lt;/b&gt; &amp;#160;Normalisation &amp;#8212; how the many&amp;#8209;to&amp;#8209;many relationships were resolved, and where derived data is stored on purpose" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;spacing=16;overflow=width;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1210" y="800" width="910" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
