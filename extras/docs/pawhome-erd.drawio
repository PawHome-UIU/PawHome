        <mxCell id="t0r4" value='&lt;table cellpadding="0" cellspacing="0" border="0" style="width:308px;table-layout:fixed;font-size:13px;font-family:Helvetica,Arial,sans-serif"&gt;&lt;tr&gt;&lt;td style="width:32px"&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style="width:158px"&gt;quiz_score&lt;/td&gt;&lt;td style="width:118px;text-align:right"&gt;SMALLINT NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=11;overflow=hidden;points=[[0,0.5,0,0,0],[1,0.5,0,0,0]];portConstraint=eastwest;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="t0">
