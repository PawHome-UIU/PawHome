# Copy to .env ONLY if the backend is somewhere other than localhost.
#
# Vite exposes only VITE_-prefixed variables, and INLINES them at BUILD time --
# restart `npm run dev` after changing anything here.
#
# Leave this file uncopied and everything defaults to localhost:8081, so a
# normal `npm run dev` needs no setup.

VITE_API_URL=http://localhost:8081/api/v1

# Demoing on a phone? Use the Mac's LAN IP (ipconfig getifaddr en0), and set
# APP_CORS_ALLOWED_ORIGINS on the backend to the matching http://<ip>:5174.
#   VITE_API_URL=http://192.168.1.20:8081/api/v1
